# Kernel configurations for full DroidSpaces + SukiSU Ultra support
# For realme GT Master Edition (RMX3366) - Kernel 4.19.157

# ===== SukiSU Ultra (kernel-based root) =====
# TEMPORARILY DISABLED for boot testing
# CONFIG_KSU=y
# CONFIG_KPM=y

# ===== Droidspaces =====
CONFIG_SYSVIPC=y
CONFIG_POSIX_MQUEUE=y
CONFIG_PID_NS=y
CONFIG_IPC_NS=y
CONFIG_USER_NS=y
CONFIG_CGROUP_DEVICE=y
CONFIG_CGROUP_PIDS=y
CONFIG_CGROUP_NET_PRIO=y
CONFIG_DEVTMPFS=y
CONFIG_FW_LOADER_COMPRESS=y
CONFIG_BRIDGE_NETFILTER=y
CONFIG_NF_TABLES=y
CONFIG_NETFILTER_XT_TARGET_MASQUERADE=y
CONFIG_NETFILTER_XT_MATCH_ADDRTYPE=y
CONFIG_NF_CONNTRACK_NETLINK=y
CONFIG_NF_CONNTRACK_IPV4=y
# CONFIG_ANDROID_PARANOID_NETWORK is not set
